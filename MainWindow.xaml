<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="Nappali" Height="450" Width="800" x:Name="mainWindow">
    <StackPanel Margin="20">
        <TextBlock x:Name="deviceNameText" Text="Termosztát"></TextBlock>
        <TextBox x:Name="roomNameBox" Text="{Binding ElementName=mainWindow, Path=Title, UpdateSourceTrigger=PropertyChanged}"></TextBox>
        <Slider x:Name="temperatureSlider" Minimum="16" Maximum="30" Value="21" TickFrequency="1" IsSnapToTickEnabled="True"></Slider>
        <TextBlock x:Name="temperatureText" Text="{Binding ElementName=temperatureSlider, Path=Value, StringFormat={}{0}°C}"></TextBlock>
        <TextBox x:Name="temperatureBox" Text="{Binding ElementName=temperatureSlider, Path=Value}"></TextBox>
        <CheckBox x:Name="manualModeCheckBox" Content="Kézi"></CheckBox>
    </StackPanel>
    
</Window>
